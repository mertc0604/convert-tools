{
  "name": "convert-tools",
  "version": "2.0.0",
  "description": "Türkçe ve İngilizce kesin uzunluk ve koordinat dönüşüm aracı",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "vite --host 127.0.0.1",
    "test": "pnpm test:core && vite build && pnpm test:integration",
    "test:core": "node --test tests/unit-engine.test.mjs tests/coordinate-engine.test.mjs tests/geodesic-engine.test.mjs",
    "test:integration": "node --test tests/rendered-html.test.mjs tests/api.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@convert-tools/core": "workspace:*",
    "cesium": "1.143.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.32",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "vite-plugin-static-copy": "4.1.1",
    "wrangler": "4.114.0"
  },
  "type": "module"
}
